+// SPIKE (M1-19, not for commit): three axes and a square, for measuring how
+// lines are rasterized on different GPUs.
+std::expected<ProbeScene, RenderError> createLinesScene(VulkanContext& context,
+                                                        const std::filesystem::path& shaderDirectory,
+                                                        const ProbeConditions& conditions) {
+    const view::Camera& camera = conditions.camera;
+    constexpr f32 kLevel = 130.0F; // W/(m^2 sr), about the lambert patch's radiance
+    const view::Rgba red{.r = kLevel, .g = 0.0F, .b = 0.0F, .a = 1.0F};
+    const view::Rgba green{.r = 0.0F, .g = kLevel, .b = 0.0F, .a = 1.0F};
+    const view::Rgba blue{.r = 0.0F, .g = 0.0F, .b = kLevel, .a = 1.0F};
+    const view::Rgba white{.r = kLevel, .g = kLevel, .b = kLevel, .a = 1.0F};
+    const auto v = [&](const Position& p, const view::Rgba& c) {
+        return view::LineVertex{.position = view::toRenderSpace(p, camera), .colour = c};
+    };
+    const Position o{0.0, 0.0, 0.0};
+    const Position s0{0.25, 0.25, 0.0};
+    const Position s1{1.25, 0.25, 0.0};
+    const Position s2{1.25, 1.25, 0.0};
+    const Position s3{0.25, 1.25, 0.0};
+    const std::array vertices{
+        v(o, red),    v(Position{1.0, 0.0, 0.0}, red),
+        v(o, green),  v(Position{0.0, 1.0, 0.0}, green),
+        v(o, blue),   v(Position{0.0, 0.0, 1.0}, blue),
+        v(s0, white), v(s1, white), v(s1, white), v(s2, white),
+        v(s2, white), v(s3, white), v(s3, white), v(s0, white),
+    };
+    const std::span<const std::byte> vertexBytes = std::as_bytes(std::span(vertices));
+    auto buffer = context.createBuffer({
+        .size = vertexBytes.size(),
+        .usage = VkBufferUsageFlags{VK_BUFFER_USAGE_VERTEX_BUFFER_BIT} |
+                 VkBufferUsageFlags{VK_BUFFER_USAGE_TRANSFER_DST_BIT},
+        .memory = Memory::DeviceLocal,
+    });
+    if (!buffer) return std::unexpected(buffer.error());
+    if (auto uploaded = context.uploadBuffer(*buffer, vertexBytes); !uploaded) {
+        return std::unexpected(uploaded.error());
+    }
+    const view::Aspect aspect{static_cast<f64>(view::kProbeImageSize.width) /
+                              static_cast<f64>(view::kProbeImageSize.height)};
+    const auto projection =
+        view::infiniteReverseZPerspective(camera.verticalFov(), aspect, camera.nearPlane());
+    ORBSIM_ENSURES(projection.has_value());
+    const view::LinePushConstants block{
+        .viewProjection = view::toShaderMatrix(*projection * view::viewMatrix(camera)),
+        .tint = {1.0F, 1.0F, 1.0F, 1.0F},
+    };
+
+    auto vertexShader = context.loadShaderModule(shaderDirectory / "line.vert.spv");
+    if (!vertexShader) return std::unexpected(vertexShader.error());
+    auto fragmentShader = context.loadShaderModule(shaderDirectory / "line.frag.spv");
+    if (!fragmentShader) return std::unexpected(fragmentShader.error());
+    const auto attributes = view::kLineVertexLayout.attributes();
+    const std::array pushConstants{view::kLinePushConstantRange};
+    auto pipeline = GraphicsPipeline::create(
+        context.device(),
+        {
+            .shaders = {.vertex = vertexShader->get(), .fragment = fragmentShader->get()},
+            .vertexInput = {.stride = view::kLineVertexLayout.stride(), .attributes = attributes},
+            .topology = Topology::LineList,
+            .polygonMode = PolygonMode::Fill,
+            .cullMode = CullMode::None,
+            .depth = {.test = DepthTest::Enabled, .write = DepthWrite::Disabled},
+            .attachments = {.colour = kHdrFormat, .depth = kDepthFormat},
+            .pushConstants = pushConstants,
+            .descriptorSetLayouts = {},
+        });
+    if (!pipeline) return std::unexpected(pipeline.error());
+    return ProbeScene{ProbeDraw{
+        .pipeline = *std::move(pipeline),
+        .vertices = *std::move(buffer),
+        .vertexCount = static_cast<std::uint32_t>(vertices.size()),
+        .pushConstants = bytesOf(block),
+        .pushStages = VK_SHADER_STAGE_VERTEX_BIT,
+    }};
+}
+
+ProbeConditions linesConditions() {
+    // Camera 5 m from (0.5, 0.5, 0.3), on the diagonal azimuth, 30 degrees up,
+    // world Z up on screen. Orientation is camera-to-world: columns are the
+    // camera's right, up and back in world coordinates.
+    const f64 elevation = kPi / 6.0;
+    const f64 c = std::cos(elevation) / std::sqrt(2.0);
+    const std::array<f64, 3> back{c, c, std::sin(elevation)};
+    const f64 r = 1.0 / std::sqrt(2.0);
+    const std::array<f64, 3> right{-r, r, 0.0};
+    const std::array<f64, 3> up{back.at(1) * right.at(2) - back.at(2) * right.at(1),
+                       back.at(2) * right.at(0) - back.at(0) * right.at(2),
+                       back.at(0) * right.at(1) - back.at(1) * right.at(0)};
+    RotationMatrix m{};
+    for (std::size_t i = 0; i < 3; ++i) {
+        m.rows.at(i) = {right.at(i), up.at(i), back.at(i)};
+    }
+    const Position target{0.5, 0.5, 0.3};
+    const f64 d = 5.0;
+    const auto camera = view::Camera::from(
+        Position{target.x.value() + d * back.at(0), target.y.value() + d * back.at(1),
+                 target.z.value() + d * back.at(2)},
+        quaternionFrom(m), Radians{kPi / 4.0}, Metres{1.0});
+    ORBSIM_ENSURES(camera.has_value());
+    ProbeConditions conditions = clearConditions();
+    conditions.camera = camera.value();
+    conditions.picture = LinesPicture{};
+    return conditions;
+}
