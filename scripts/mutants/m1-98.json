{
  "task": "M1-98",
  "tree": "build/relwithdebinfo",
  "note": "The stale-tree guard (register decision 225). The script mutants blind scripts/check-configure-current.py one way each and are judged by its self-test; the module mutants break the configure-time refusal or its record and are judged by configure_guard, which configures a scratch project that edits itself, and by configure_current on this tree; the CMake mutants unhook the guard from this project and are judged by configure_current against the tree they regenerate. Nothing here needs a compile, but the harness always builds, so every mutant names orbsim_shaders -- which, after a CMakeLists.txt mutant, also regenerates the tree.",
  "mutants": [
    {
      "name": "a changed file is not reported",
      "file": "scripts/check-configure-current.py",
      "find": "        elif fingerprint(file) != was:",
      "replace": "        elif False:",
      "expect": "caught",
      "suites": [],
      "targets": [
        "orbsim_shaders"
      ],
      "ctest": [
        "configure_current_self_test",
        "configure_current"
      ]
    },
    {
      "name": "a record without CMakeLists.txt passes",
      "file": "scripts/check-configure-current.py",
      "find": "    if not any(same_path(path, root / \"CMakeLists.txt\") for _, path in entries):",
      "replace": "    if False:",
      "expect": "caught",
      "suites": [],
      "targets": [
        "orbsim_shaders"
      ],
      "ctest": [
        "configure_current_self_test",
        "configure_current"
      ]
    },
    {
      "name": "a check that does not wait for the step passes",
      "file": "scripts/check-configure-current.py",
      "find": "    if edge is None or STEP not in edge.group(0).split(\":\", 1)[-1].split():",
      "replace": "    if edge is None:",
      "expect": "caught",
      "suites": [],
      "targets": [
        "orbsim_shaders"
      ],
      "ctest": [
        "configure_current_self_test",
        "configure_current"
      ]
    },
    {
      "name": "the configure accepts an edit made while it ran",
      "file": "cmake/ConfigureInputs.cmake",
