{
  "task": "M1-08",
  "tree": "build/relwithdebinfo",
  "note": "Twelve valid mutants, twelve caught, 2026-09-20. Three are killed by a static_assert before a test runs, and one -- the transposed TT and UT1 -- is aimed at astro/EarthOrientation.cpp rather than at M1-08's own code, because decision 89 deleted TwoPartDate from it and something has to show that call site is still covered. Mutants 4 and 8 were invalid on the first attempt and are recorded here in the form that compiles.",
  "mutants": [
    {
      "name": "the Sun is not negated",
      "file": "src/astro/Sun.cpp",
      "find": "Metres{-heliocentric[0][0] * ERFA_DAU}",
      "replace": "Metres{heliocentric[0][0] * ERFA_DAU}",
      "suites": ["test_sun"],
      "expect": "caught"
    },
    {
      "name": "barycentric instead of heliocentric",
      "file": "src/astro/Sun.cpp",
      "find": "Metres{-heliocentric[0][0] * ERFA_DAU}",
      "replace": "Metres{-barycentric[0][0] * ERFA_DAU}",
      "suites": ["test_sun"],
      "expect": "caught"
    },
    {
      "name": "the velocity row instead of the position row",
      "file": "src/astro/Sun.cpp",
      "find": "Metres{-heliocentric[0][0] * ERFA_DAU}",
      "replace": "Metres{-heliocentric[1][0] * ERFA_DAU}",
      "suites": ["test_sun"],
      "expect": "caught"
    },
    {
      "name": "the range status is not checked",
      "file": "src/astro/Sun.cpp",
      "find": "if (status != 0) return std::unexpected(EphemerisError::OutsideEphemerisRange);",
      "replace": "(void)status;",
      "suites": ["test_sun"],
      "expect": "caught"
    },
    {
      "name": "x and y transposed",
      "file": "src/astro/Sun.cpp",
      "find": "const Position sun{Metres{-heliocentric[0][0] * ERFA_DAU},",
      "replace": "const Position sun{Metres{-heliocentric[0][1] * ERFA_DAU},",
      "suites": ["test_sun"],
      "expect": "caught"
    },
    {
      "name": "kilometres, not metres",
      "file": "src/astro/Sun.cpp",
      "find": "Metres{-heliocentric[0][2] * ERFA_DAU}",
      "replace": "Metres{-heliocentric[0][2] * (ERFA_DAU / 1000.0)}",
      "suites": ["test_sun"],
      "expect": "caught"
    },
    {
      "name": "the time of day is dropped",
      "file": "src/astro/Sun.cpp",
      "find": "eraEpv00(date.day, date.fraction, heliocentric, barycentric)",
