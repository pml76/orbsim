# Build output. Generated artefacts do not belong in history: they make diffs
# unreadable and the repository enormous.
build/
build-*/
cmake-build-*/
out/

# CMake per-user configuration. CMakePresets.json IS tracked; the User variant
# is local overrides and must not be.
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/

# Generated by CMAKE_EXPORT_COMPILE_COMMANDS into the build tree; the copy at
# the root, if any, is a local convenience.
/compile_commands.json
.cache/

# IDE and editor state
.idea/
.vs/
.vscode/
*.user
*.suo

# Compiled output generated outside the build tree. *.obj is here for the same
# reason as *.spv: a stray one appeared at the repository root on 2026-09-17
# because `cl` writes its object file to the working directory, and it was
# committed before anyone noticed.
*.spv
*.obj

# Profiling and sanitizer output
*.prof
*.profraw
*.profdata
callgrind.out.*

# OS noise
Thumbs.db
.DS_Store

# Planetary imagery. Source data and generated tile pyramids are hundreds of
# megabytes to tens of gigabytes and are reproducible from the source archives,
# so they are never committed. data/textures/README.md IS tracked and says where
# to get them.
data/textures/source/
data/textures/tiles/
*.dds
*.ktx2

# JPL Horizons output. Not committed -- the terms are unclear and the recipe is
# in data/horizons/README.md instead. The checksums ARE committed, so a locally
# generated fixture can be verified as the one the budgets were measured against.
data/horizons/*
!data/horizons/README.md
!data/horizons/checksums.sha256
