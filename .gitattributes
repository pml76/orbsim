# Normalise line endings in the repository to LF, matching .editorconfig.
#
# Without this, git's core.autocrlf on Windows rewrites endings on checkout and
# the two configurations disagree, which shows up later as a diff where every
# line changed and nobody can see the one line that actually did.
* text=auto eol=lf

# Binary assets: never touch these.
*.png   binary
*.jpg   binary
*.dds   binary
*.spv   binary
*.ttf   binary
*.msh   binary

# Fuzz corpora (M1-93) are raw bytes a fuzzer found; rewriting a CR LF in one
# would commit a different input from the one that reached the coverage.
tests/corpus/** binary
