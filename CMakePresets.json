{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "clang Debug",
      "description": "Assertions live. Part of the definition of done alongside relwithdebinfo.",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "clang RelWithDebInfo",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "clang Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "inherits": "relwithdebinfo",
      "displayName": "clang RelWithDebInfo + AddressSanitizer, assertions live",
      "description": "Every test under ASan. Not Debug: ASan and the MSVC debug C runtime cannot share a heap (see CMakeLists.txt), so this is the release runtime with -DNDEBUG removed from the RelWithDebInfo flags. Run before a milestone lands.",
      "cacheVariables": {
        "ORBSIM_SANITIZE_ADDRESS": "ON",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g"
      }
    },
    {
      "name": "linux-sanitize",
      "inherits": "debug",
      "displayName": "Linux: clang Debug + ASan + UBSan, core only",
      "description": "What the Linux CI job runs. UBSan is the reason a Linux build exists.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "ORBSIM_SANITIZE_ADDRESS": "ON",
        "ORBSIM_SANITIZE_UNDEFINED": "ON",
        "ORBSIM_BUILD_APP": "OFF"
      }
    },
    {
      "name": "linux-gcc",
      "inherits": "debug",
      "displayName": "Linux: gcc 14 Debug, core only",
      "description": "The second compiler. Where two compilers disagree is where the bugs live.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14",
        "ORBSIM_BUILD_APP": "OFF"
      }
    },
    {
      "name": "linux-fuzz",
      "inherits": "debug",
      "displayName": "Linux: clang + libFuzzer + ASan + UBSan, core only",
      "description": "The fuzz targets. Not part of check: a fuzzer has no natural exit, so it is run deliberately with a time budget. See VERIFICATION.md rule 13.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "ORBSIM_BUILD_FUZZERS": "ON",
        "ORBSIM_BUILD_APP": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": { "outputOnFailure": true }
    }
  ]
}
