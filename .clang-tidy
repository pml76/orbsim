# Static analysis configuration.
#
# The point of this file is to convert the advice in CODING_GUIDELINES.md into
# something a machine enforces on every build, because advice that relies on
# everyone remembering decays and advice a tool checks does not.
#
# Every disabled check below has a reason next to it. If you disable one more,
# write the reason too -- a bare list of suppressions is how a lint config
# quietly becomes meaningless.
---
Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  misc-*,

  -bugprone-narrowing-conversions,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -misc-include-cleaner,
  -readability-braces-around-statements,
  -modernize-use-nodiscard,
  -performance-enum-size,

# Only our code. The dependency tree under _deps is not ours to lint, and
# linting it buries every finding that matters.
#
# Both separators, deliberately. clang-tidy on Windows reports a header as
# `src\core/Math.hpp` -- the compile database's forward slashes up to the
# include directory, then the backslash the driver joined the include path
# with. A regex that only accepts `/` matched nothing, and every header in
# this tree went unlinted for the first sixteen commits while the .cpp files
# reported clean. If this ever regresses, `--header-filter='.*'` on one
# translation unit will show findings this filter does not.
HeaderFilterRegex: '.*[/\\](src|tests)[/\\].*\.(hpp|h)$'
ExcludeHeaderFilterRegex: '.*_deps.*'

# The tree is clean under this configuration, so the findings are errors: the
# count can now only go down. If that ever becomes impractical, narrow this to
# the highest-signal families rather than emptying it -- a lint config nobody
# has to satisfy is a lint config nobody reads.
WarningsAsErrors: '*'

CheckOptions:
  # Matches the naming rules in section 15 of CODING_GUIDELINES.md.
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k

  # Section 17: functions should fit on a screen. VulkanContext::init() used to
  # be 149 lines doing eight jobs; it is now 29 and delegates to five named
  # steps, which is what this threshold is here to keep true.
  - key: readability-function-size.LineThreshold
    value: '80'
  - key: readability-function-size.StatementThreshold
    value: '60'
  - key: readability-function-size.NestingThreshold
    value: '5'

# --- notes on the disabled checks -------------------------------------------
#
# bugprone-narrowing-conversions / cppcoreguidelines-narrowing-conversions
#   This codebase computes in f64 and hands f32 to the GPU by design. The
#   compiler's -Wconversion already flags every narrowing, and section 1 argues
#   for keeping that on; two tools shouting the same thing is noise, and the
#   compiler's version is the one that cannot be forgotten.
#
# *-magic-numbers
#   In orbital mechanics, 2.0, 0.5 and 180.0 are mathematics, not magic. The
#   constants that DO deserve names (tolerances, iteration caps) are covered by
#   section 16, which asks for a comment saying where the number came from --
#   a requirement no linter can check.
#
# readability-identifier-length
#   dt, mu, e, i, r0 are the standard symbols of the domain. Renaming them to
#   satisfy a linter would make the code harder to check against a textbook.
#
# modernize-use-trailing-return-type
#   Pure style, and not the style used here.
#
# cppcoreguidelines-pro-bounds-* and pro-type-reinterpret-cast / pro-type-vararg
#   Unavoidable when calling the Vulkan and SDL C APIs. Keep them suppressed at
#   the renderer boundary, never in orbsim_core.
#
# misc-include-cleaner
#   Valuable, but extremely noisy against the Vulkan headers. Run
#   include-what-you-use as a periodic job instead (see the Toolbox).
#
# readability-braces-around-statements
#   `if (cond) return x;` on one line is used deliberately for guard clauses.
#
# performance-enum-size
#   Suggests giving every enum an explicit uint8_t base. These enums are
#   function parameters and members of structs dominated by pointers and
#   64-bit handles, so shrinking them changes nothing measurable -- and
#   section 10 says do not optimize without a measurement.
#
# modernize-use-nodiscard
#   Suggests [[nodiscard]] on almost every const member function. Section 5
#   asks for it where the return value IS the point, which is a judgement call.
#
# bugprone-easily-swappable-parameters
#   The mechanical enforcement of I.24 and section 2. It fired on
#   propagate(sv, mu, dt) and on three test helpers, which is exactly what it is
#   for: those were real defects, and they were fixed by introducing Radians,
#   Seconds, GravParam and Tolerance rather than by suppressing the check.
