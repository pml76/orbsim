# [S1][S17] Static analysis for the example.
#
# This file is what turns the advice in CODING_GUIDELINES.md into something a
# machine enforces on every build. Advice that relies on everyone remembering
# decays; advice a tool checks does not.
#
# The example currently produces ZERO findings under this configuration. That is
# a property worth keeping: the moment it produces one, either the code drifted
# or the rule changed, and both are worth a look.
#
# Every disabled check below carries the reason it is disabled. A suppression
# list without reasons is how a lint config quietly stops meaning anything.
---
Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,

  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -modernize-use-trailing-return-type,

# Both separators, deliberately: clang-tidy on Windows reports a header as
# `src\core/Vec3.hpp`, and a regex that accepts only `/` matches nothing --
# which is how the parent project's headers went unlinted while its .cpp files
# reported clean. `--header-filter='.*'` on one translation unit is the test.
HeaderFilterRegex: '.*[/\\](src|tests)[/\\].*\.hpp$'

# [S1] The example is required to stay clean, so the checks are errors rather
# than suggestions. In a codebase with an existing backlog you would ratchet
# this on family by family instead; here there is no backlog to ratchet.
WarningsAsErrors: '*'

CheckOptions:
  # [S15] The naming rules from section 15, mechanised.
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  # [S17] Functions fit on a screen. The largest here is OrbitPath::sample.
  - key: readability-function-size.LineThreshold
    value: '80'
  - key: readability-function-size.StatementThreshold
    value: '50'
  - key: readability-function-size.NestingThreshold
    value: '4'

  # [S15] The single-line guard clause (`if (!path) return;`) is the documented
  # house style; a body that runs onto its own line is not, and gets braces.
  # Configured rather than disabled: at this threshold the example has zero
  # findings, so the check is live and costs nothing.
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'

  # [S8] Vec3, PathVertex and the unit types are aggregates with no invariant to
  # protect: their members ARE the interface. This option says exactly that --
  # exempt a class whose data is *entirely* public -- which leaves the check
  # live for the case it is actually aimed at, a class that has an invariant and
  # leaks part of it. It replaces a blanket suppression that could not tell the
  # two apart. OrbitPath, which does have an invariant, keeps its data private
  # and is still checked.
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: 'true'

# --- why each disabled check is disabled ------------------------------------
#
# This list was ten checks long until 2026-09-08, when it was emptied and every
# finding that came out of it was fixed rather than re-suppressed. Six went for
# good; what they cost is recorded here so nobody re-adds them:
#
#   bugprone-narrowing-conversions            0 findings. -Wconversion already
#   cppcoreguidelines-narrowing-conversions   0 findings.   covers this.
#   modernize-use-nodiscard                   0 findings; every function that
#                                             warrants the attribute has it.
#   readability-braces-around-statements      0 findings at ShortStatementLines
#                                             1, which is the house style
#                                             written as a number.
#   misc-non-private-member-variables-in-classes
#                                             73 -> 0 via the option above,
#                                             which distinguishes an aggregate
#                                             from a leaky class; the blanket
#                                             suppression could not.
#   misc-include-cleaner                      45 findings, all fixed. In the
#                                             parent project this is the check
#                                             that would have caught a missing
#                                             <tuple> that only gcc found.
#
# The four below still fire. Each says why it is off and what it would cost.
#
# *-magic-numbers (211 findings)
#   In orbital mechanics 2.0, 0.5 and 180.0 are mathematics, not magic. The
#   constants that DO deserve names have them (kHighEccentricity,
#   kConvergence, kMaxIterations), each with a comment saying where its value
#   came from -- which is section 16, and which no linter can check.
#
# readability-identifier-length (160 findings)
#   e, m, nu, c, s are the standard symbols of the domain. Renaming them to
#   satisfy a linter would make the code harder to check against a textbook.
#   The check can take an allow-list instead (IgnoredVariableNames /
#   IgnoredParameterNames), which would keep it live for names that are short
#   AND meaningless.
#
# modernize-use-trailing-return-type (153 findings)
#   Pure style, and not the style used here or in the parent project.
#   Satisfying it means rewriting every function signature as `auto f() -> T`.
#
# bugprone-easily-swappable-parameters
#   The mechanical enforcement of I.24 and section 2. It found a real defect in
#   this example -- nearlyEqual(f64, f64, f64) -- which was fixed by introducing
#   the Tolerance type rather than by suppressing the check. The one place it is
#   silenced is on nearlyEqual's remaining two parameters, which are genuinely
#   commutative, and the NOLINT there says so.
